{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@prisma/client": "6.16.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.6.0",
    "fastify": "5.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "prisma": "6.16.2",
    "tsx": "4.19.3",
    "typescript": "5.9.2"
  }
}
